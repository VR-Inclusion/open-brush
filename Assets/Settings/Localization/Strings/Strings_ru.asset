  - m_Id: 565385129362972681
    m_Localized: "\u041E\u0434\u043D\u0430 \u0438\u0437 \u043D\u0430\u0448\u0438\u0445
      \u0441\u0430\u043C\u044B\u0445 \u043C\u043E\u0449\u043D\u044B\u0445 \u043D\u043E\u0432\u044B\u0445
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439, \u043D\u0430\u0434
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043C\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442.
      \u041F\u043B\u0430\u0433\u0438\u043D\u044B \u2014 \u044D\u0442\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435
      \u0441\u043A\u0440\u0438\u043F\u0442\u044B Lua, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043C\u0435\u043D\u044F\u044E\u0442 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u0440\u0438\u0441\u043E\u0432\u0430\u043D\u0438\u044F
      Open Brush \u0438\u043B\u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442
      \u043D\u043E\u0432\u044B\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B.
      \u041C\u044B \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0438 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
      \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u0432: \u043E\u043D\u0438 \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u044E\u0442
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430
      \u0438 \u043F\u043E\u043C\u043E\u0433\u0443\u0442 \u0432\u0430\u043C \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u043F\u043B\u0430\u0433\u0438\u043D\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438 \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0441 \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E\u043C."
