  - m_Id: 565385129362972685
    m_Localized: "\u0421\u0440\u043E\u043A \u043A\u043E\u043D\u043A\u0443\u0440\u0441\u0430
      Viverse \u043F\u0440\u043E\u0434\u043B\u0451\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 565385129362972686
    m_Localized: "\u0420\u0430\u043D\u044C\u0448\u0435 \u043C\u043E\u0436\u043D\u043E
      \u0431\u044B\u043B\u043E \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0435 \u0447\u0430\u0441\u0442\u0438
      \u044D\u0441\u043A\u0438\u0437\u0430 \u0432 \u0432\u0438\u0434\u0435 3D-\u043C\u043E\u0434\u0435\u043B\u0435\u0439.
      \u0423 \u044D\u0442\u043E\u0433\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u0430
      \u0431\u044B\u043B\u0438 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F:
      \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430 \u041F\u041A, \u0448\u0442\u0440\u0438\u0445\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u0430\u043B\u0438
      \u0431\u044B\u0442\u044C \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u0443\u0435\u043C\u044B\u043C\u0438,
      \u0430 \u0438\u0445 \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u0432\u0438\u0434
      \u0447\u0430\u0441\u0442\u043E \u043C\u0435\u043D\u044F\u043B\u0441\u044F \u043F\u0440\u0438
      \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0438.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0435
      \u0448\u0442\u0440\u0438\u0445\u0438 \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C
      \u0431\u0435\u0437 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u0432 3D-\u0441\u0435\u0442\u043A\u0443. \u041F\u0440\u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0438
      \u0432 \u0441\u0446\u0435\u043D\u0443 \u043E\u043D\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u043A\u0430\u043A \u0433\u0440\u0443\u043F\u043F\u0430 \u043E\u0431\u044B\u0447\u043D\u044B\u0445
      \u0448\u0442\u0440\u0438\u0445\u043E\u0432: \u0435\u0451 \u043C\u043E\u0436\u043D\u043E
      \u0440\u0430\u0437\u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C,
      \u043F\u0435\u0440\u0435\u043A\u0440\u0430\u0441\u0438\u0442\u044C, \u0441\u043C\u0435\u043D\u0438\u0442\u044C
      \u043A\u0438\u0441\u0442\u044C \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
