    m_Metadata:
      m_Items: []
  - m_Id: 565385129358778371
    m_Localized: "Open Brush \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u043F\u0440\u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
      \u044D\u0441\u043A\u0438\u0437\u044B \u043D\u0430 Mac, \u041F\u041A \u0438
      \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u0445 Android
      \u0434\u0430\u0436\u0435 \u0431\u0435\u0437 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438
      VR. \u0412 \u044D\u0442\u043E\u043C \u0432\u044B\u043F\u0443\u0441\u043A\u0435
      \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043E \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435:
      \u0441\u0435\u043D\u0441\u043E\u0440\u043D\u044B\u0435 \u0436\u0435\u0441\u0442\u044B
      \u043D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430\u0445 \u0441\u0442\u0430\u043B\u0438
      \u0443\u0434\u043E\u0431\u043D\u0435\u0435, \u0430 \u043E\u0431\u044B\u0447\u043D\u044B\u0435
      \u0433\u0435\u0439\u043C\u043F\u0430\u0434\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
      \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C.\n\n\u041A\u0440\u043E\u043C\u0435
      \u0442\u043E\u0433\u043E, \u0442\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u043D\u043E
      \u043F\u0440\u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u0432
      \u044D\u0441\u043A\u0438\u0437\u043E\u0432, \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043C\u044B\u0445
      \u043F\u0440\u044F\u043C\u043E \u0438\u0437 Icosa Gallery. \u041D\u0430 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u0445
      \u0431\u0435\u0437 VR \u0442\u0430\u043A\u0436\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0432\u0435\u0431-API \u0438 \u043C\u043E\u043D\u043E\u0441\u043A\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0440\u0435\u0436\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 565385129358778372
    m_Localized: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u0440\u0435\u0436\u0438\u043C\u0430
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 565385129358778373
    m_Localized: "\u0420\u0430\u043D\u044C\u0448\u0435 \u043D\u0430 \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u044B\u0445
      VR-\u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u0445, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440
      Quest, \u0431\u044B\u043B\u043E \u043C\u0435\u043D\u044C\u0448\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432
      \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u0438\u044F, \u0447\u0435\u043C
      \u043D\u0430 \u041F\u041A. \u042D\u0442\u043E \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435
      \u043F\u043E\u044F\u0432\u0438\u043B\u043E\u0441\u044C \u0438\u0437-\u0437\u0430
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E Quest. \u041D\u043E\u0432\u044B\u0435
      \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u043C\u043E\u0449\u043D\u0435\u0435,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0432\u0441\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u043D\u0430 \u0432\u0441\u0435\u0445
      \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430\u0445, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
      \u043A\u043E\u043C\u0430\u043D\u0434\u044B \xAB\u0412\u044B\u0434\u0435\u043B\u0438\u0442\u044C
      \u0432\u0441\u0451\xBB \u0438 \xAB\u0418\u043D\u0432\u0435\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u0438\u0435\xBB. \u0412 \u0441\u043B\u043E\u0436\u043D\u044B\u0445
      \u0441\u0446\u0435\u043D\u0430\u0445 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B
      \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438, \u043D\u043E \u0432\u044B\u0431\u043E\u0440
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0437\u0430 \u0432\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 565385129358778374
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432
      \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0432 \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u043E\u043C
      VR"
    m_Metadata:
      m_Items: []
  - m_Id: 565385129358778375
    m_Localized: "\u0422\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 \u043A\u0430\u043C\u0435\u0440\u044B
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C
      \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0438 \u043F\u0430\u043D\u043E\u0440\u0430\u043C\u043D\u044B\u0435
      \u0432\u0438\u0434\u0435\u043E \u0441 \u043E\u0431\u043B\u0451\u0442\u043E\u043C
      \u0432\u0430\u0448\u0438\u0445 \u0440\u0430\u0431\u043E\u0442. \u041F\u0440\u044F\u043C\u0430\u044F
      \u0437\u0430\u043F\u0438\u0441\u044C \u0432\u0438\u0434\u0435\u043E \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0435.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
      \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u0445 \u043C\u043E\u0436\u043D\u043E
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
      \u043A\u0430\u0434\u0440\u044B \u0432\u0438\u0434\u0435\u043E. \u0418\u0445
      \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0432
      \u0432\u0438\u0434\u0435\u043E\u0440\u043E\u043B\u0438\u043A \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u0432\u0435\u0431-\u0441\u0435\u0440\u0432\u0438\u0441\u0430, \u0432\u0438\u0434\u0435\u043E\u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0430
      \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 565385129358778376
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u044C \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0439
      \u043A\u0430\u043C\u0435\u0440\u044B \u043D\u0430 \u0432\u0441\u0435\u0445
      \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u0445"
    m_Metadata:
