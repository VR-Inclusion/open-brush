  - m_Id: 565385129362972679
    m_Localized: "\u041D\u0430\u0448\u0435 \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 Open Blocks \u2014
      \u0443\u0434\u043E\u0431\u043D\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u043D\u0438\u0437\u043A\u043E\u043F\u043E\u043B\u0438\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
      3D-\u043C\u043E\u0434\u0435\u043B\u0435\u0439 \u043D\u0430 \u041F\u041A \u0438
      \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u044B\u0445 VR-\u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u0445.
      \u041F\u043E\u0441\u043B\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
      Open Blocks \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0435
      \u043D\u0430 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435 \u043C\u043E\u0434\u0435\u043B\u0438
      \u043C\u043E\u0436\u043D\u043E \u043B\u0435\u0433\u043A\u043E \u0438\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0431\u044B\u0447\u043D\u0443\u044E \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0443
      3D-\u043C\u043E\u0434\u0435\u043B\u0435\u0439."
