  - m_Id: 565385129362972677
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u044D\u0441\u043A\u0438\u0437\u044B
      Open Brush \u043C\u043E\u0436\u043D\u043E \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u044F\u043C\u043E \u0432 Viverse \u0432\u0441\u0435\u0433\u043E
      \u0437\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0436\u0430\u0442\u0438\u0439.\n\nViverse
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C
      \u0442\u0440\u0451\u0445\u043C\u0435\u0440\u043D\u044B\u0435 \u043C\u0438\u0440\u044B
      \u0438 \u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0438\u043C\u0438
      \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435. \u041F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u044C
      \u043F\u043E\u0447\u0442\u0438 \u0441 \u043B\u044E\u0431\u043E\u0433\u043E
      \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430: \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430,
      \u043F\u043B\u0430\u043D\u0448\u0435\u0442\u0430, \u041F\u041A, Mac \u0438,
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E, VR-\u0448\u043B\u0435\u043C\u0430.\n\n\u0412
      \u043C\u0438\u0440\u0430\u0445 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B
      \u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0438 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E\u0435
      \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u0438\u0435. \u041F\u0440\u0438
      \u0436\u0435\u043B\u0430\u043D\u0438\u0438 \u0430\u0432\u0442\u043E\u0440\u044B
      \u043C\u043E\u0433\u0443\u0442 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u044E \u0434\u043B\u044F
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438 \u0441\u0432\u043E\u0435\u0433\u043E
      \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
