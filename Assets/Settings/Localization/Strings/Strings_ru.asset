    m_Localized: "Viverse \u043E\u0431\u044A\u044F\u0432\u0438\u043B \u043E \u043F\u0440\u043E\u0434\u043B\u0435\u043D\u0438\u0438
      \u043F\u0440\u0438\u0451\u043C\u0430 \u0440\u0430\u0431\u043E\u0442 \u043D\u0430
      \u043A\u043E\u043D\u043A\u0443\u0440\u0441 VIVERSE Open Brush Art Jam \u0434\u043E
      17 \u0430\u043F\u0440\u0435\u043B\u044F, 23:59 \u043F\u043E \u0442\u0438\u0445\u043E\u043E\u043A\u0435\u0430\u043D\u0441\u043A\u043E\u043C\u0443
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u0427\u0442\u043E\u0431\u044B
      \u043D\u0430\u0447\u0430\u0442\u044C, \u043F\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435
      \u043F\u043E \u0441\u0441\u044B\u043B\u043A\u0435 https://link.viverse.com/openbrush
      \u0438\u043B\u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
      \u043D\u0438\u0436\u0435:"
