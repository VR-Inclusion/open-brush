      Open Brush \u0441 \u043F\u0440\u0438\u0437\u0430\u043C\u0438 \u0434\u043E 2500
      \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432. \u0421\u043E\u0437\u0434\u0430\u0439\u0442\u0435
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0432 Open Brush, \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u0443\u0439\u0442\u0435
      \u0435\u0451 \u0432 Viverse \u043A\u0430\u043A \u0438\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u0443\u044E
