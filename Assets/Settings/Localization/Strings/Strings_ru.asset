  - m_Id: 565385129358778377
    m_Localized: "\u0424\u043E\u0440\u043C\u0430\u0442 Magicavoxel .vox \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0432\u043E \u043C\u043D\u043E\u0433\u0438\u0445 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0430\u0445
      \u0432\u043E\u043A\u0441\u0435\u043B\u044C\u043D\u044B\u0445 \u043C\u043E\u0434\u0435\u043B\u0435\u0439.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u0430\u043A\u0438\u0435 \u043C\u043E\u0434\u0435\u043B\u0438
      \u043C\u043E\u0436\u043D\u043E \u0438\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0434\u0440\u0443\u0433\u0438\u0435
      3D-\u0444\u043E\u0440\u043C\u0430\u0442\u044B, \u0438 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C
      \u0438\u0437 \u043D\u0438\u0445 \u0446\u0435\u043B\u044B\u0435 \u0441\u0446\u0435\u043D\u044B.
      \u0427\u0442\u043E\u0431\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u0432\u044B\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u043D\u0438\u0435 \u043F\u043E
      \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u0439 \u0441\u0435\u0442\u043A\u0435,
      \u043F\u0435\u0440\u0435\u0434 \u0438\u043C\u043F\u043E\u0440\u0442\u043E\u043C
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0448\u0430\u0433
      \u043F\u0440\u0438\u0432\u044F\u0437\u043A\u0438 \u043A \u0441\u0435\u0442\u043A\u0435
      0,1 \u0438 \u0443\u0433\u043E\u043B \u043F\u0440\u0438\u0432\u044F\u0437\u043A\u0438
      90 \u0433\u0440\u0430\u0434\u0443\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 565385129358778378
    m_Localized: "\u0418\u043C\u043F\u043E\u0440\u0442 \u0444\u0430\u0439\u043B\u043E\u0432
      VOX"
    m_Metadata:
      m_Items: []
  - m_Id: 565385129358778379
    m_Localized: "\u0418\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      3D-\u043C\u043E\u0434\u0435\u043B\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442
      \u0434\u043E\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u044D\u0441\u043A\u0438\u0437\u044B,
      \u043D\u043E \u0447\u0430\u0441\u0442\u043E \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u0440\u0443\u0434\u043D\u043E
      \u043E\u0442\u0434\u0435\u043B\u0438\u0442\u044C \u0434\u0440\u0443\u0433 \u043E\u0442
      \u0434\u0440\u0443\u0433\u0430. \u0422\u0435\u043F\u0435\u0440\u044C \u0438\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0443\u044E
      \u043C\u043E\u0434\u0435\u043B\u044C \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C
      \u043D\u0430 \u0447\u0430\u0441\u0442\u0438, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
